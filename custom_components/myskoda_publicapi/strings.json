          "poll_interval_in_minutes": "Polling interval",
          "spin": "S-PIN (required for auxiliary heating)",
          "refresh_after_command": "Refresh shortly after a command"
        }
      }
    },
    "error": {
      "invalid_spin": "The S-PIN consists of digits only."
    }
  },
