{
  "config": {
    "step": {
      "user": {
        "title": "MyŠkoda API key",
        "description": "Enter the API key you created in the MyŠkoda app under API keys ({url}). The key is bound to the vehicles you selected when creating it and it expires, so you will be asked for a new one when it lapses.",
        "data": {
          "api_key": "API key"
        }
      },
      "vehicles": {
        "title": "Vehicles",
        "description": "The public API has no endpoint that lists the vehicles an API key covers, so the VINs have to be entered here. Add one VIN (17 characters) per entry, exactly the vehicles you selected when creating the key.",
        "data": {
          "vins": "VIN"
        }
      },
      "reauth_confirm": {
        "title": "Renew the API key",
        "description": "The API key is no longer valid. Create a new one in the MyŠkoda app ({url}) for the same vehicles and enter it here.",
        "data": {
          "api_key": "API key"
        }
      }
    },
    "error": {
      "invalid_api_key": "The API key was rejected.",
      "expired_api_key": "The API key has expired. Create a new one in the MyŠkoda app.",
      "vehicle_not_authorized": "The API key does not cover this vehicle. Create a key that includes it.",
      "vehicle_not_found": "No vehicle exists for this VIN.",
      "invalid_vin": "A VIN has exactly 17 characters.",
      "no_vehicles": "Enter at least one VIN.",
      "rate_limited": "The hourly request limit is exhausted. Try again later.",
      "cannot_connect": "Failed to connect to the MyŠkoda API.",
      "unknown": "Unexpected error."
    },
    "abort": {
      "already_configured": "These vehicles are already configured.",
      "reauth_successful": "The API key was updated.",
      "reconfigure_successful": "The configuration was updated.",
      "different_vehicles": "The new API key covers different vehicles. Add them as a separate entry."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "description": "The MyŠkoda API allows 20 requests per hour per API key, shared by every vehicle and every remote command. With {vehicles} vehicle(s) the current interval uses about {requests_per_hour} requests per hour for polling alone.",
